{
	"name": "mod-scraper",
	"type": "module",
	"private": true,
	"scripts": {
		"check-formatting": "bun run prettier --check .",
		"create-migration": "bun --bun run typeorm migration:create",
		"format": "bun run prettier --write .",
		"generate-api-clients": "bun --bun run openapi-ts",
		"generate-migration": "bun --bun run typeorm migration:generate -d src/db/dataSource.ts",
		"lint": "bun run eslint .",
		"lint-fix": "bun run eslint --fix .",
		"migrate-all": "bun run migrate-regular-db && bun run migrate-unit-test-db",
		"migrate-regular-db": "bun --bun run typeorm migration:run -d src/db/dataSource.ts",
		"migrate-unit-test-db": "bun --bun run typeorm migration:run -d src/db/createTestDataSource.ts",
		"start": "bun run src/index.ts",
		"typecheck": "bun run tsc --noEmit --project tsconfig.json",
		"watch": "bun run --watch src/index.ts"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@hey-api/openapi-ts": "^0.90.2",
		"@stylistic/eslint-plugin": "^5.6.1",
		"@types/bun": "latest",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.7.4",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.51.0"
	},
	"devEngines": {
		"runtime": {
			"name": "bun",
			"onFail": "error"
		},
		"packageManager": {
			"name": "bun",
			"onFail": "error"
		}
	},
	"engines": {
		"bun": ">=1.3.5"
	},
	"dependencies": {
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^0.3.28"
	}
}
